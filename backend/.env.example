# ============================================================
# EKA Python 后端环境变量模板
# 用法：复制本文件为 .env，按需修改；.env 已被 .gitignore 排除，切勿提交
# 说明：所有值均为占位符，请替换成自己的真实配置
# ============================================================

# ---- 服务 ----
APP_PORT=8080
APP_RELOAD=true

# ---- MySQL（Python 版使用独立数据库，与 Java 版隔离）----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=enterprise_knowledge_agent_py

# ---- 存储目录（相对 backend/ 解析；数据目录不入版本库，需本地自备）----
SESSION_ROOT=Edit-File
ARCHIVE_ROOT=File
MD_ROOT=MD
DEFAULT_USER_ID=1

# ---- 跨域：允许访问的前端来源，逗号分隔 ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据库 SQL 工具 ----
SQL_MD_ROOT=MD
SQL_DATABASE=enterprise_knowledge_agent_py
SQL_MAX_ROWS=100
SQL_TIMEOUT_SECONDS=4
SQL_TABLE_CACHE_SECONDS=300

# ---- 对话模型：主用 DeepSeek，兜底通义千问 ----
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_API_KEY=your-deepseek-api-key
LLM_PRIMARY_MODEL=deepseek-v4-flash
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
LLM_FALLBACK_API_KEY=your-dashscope-api-key
LLM_FALLBACK_MODEL=qwen3.7-flash
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
TOOL_MAX_RETRIES=2

# ---- 上下文压缩 ----
COMPACTION_TRIGGER_TOKENS=4000
COMPACTION_KEEP_MESSAGES=20

# ---- RAG 混合检索（Elasticsearch + 向量 + 重排序）----
ES_URL=http://127.0.0.1:9200
ES_INDEX=eka-rag
ES_TIMEOUT_SECONDS=5
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
# 留空则回退到兜底模型（DashScope）的 Key
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIMENSIONS=1024
RAG_VECTOR_TOP_K=20
RAG_KEYWORD_TOP_K=20
RAG_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=qwen3-vl-rerank
RAG_RERANK_TOP_N=10
RAG_RERANK_TIMEOUT_SECONDS=10
